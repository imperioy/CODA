{
  "name": "Coda",
  "version": "1.0.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron": "electron .",
    "build:exe": "electron-builder --win"
  },
  "build": {
    "appId": "com.coda.desktop",
    "productName": "Coda",
    "icon": "public/libro.ico",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "files": [
      "main.js",
      "out/**/*",
      "node_modules/**/*"
    ]
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@tailwindcss/postcss": "^4.3.5",
    "electron-serve": "^3.0.1",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "postcss": "^8.5.32",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
